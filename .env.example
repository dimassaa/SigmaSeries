# Переменные окружения для локального запуска.
#
# Скопируйте в `.env` и заполните: `.env` уже в `.gitignore`, в репозиторий
# он не попадёт. Файл читается сам — `npm start` и `npm test` запускаются с
# `--env-file-if-exists=.env`, и отдельного `export` не нужно.
#
# Настоящее развёртывание переменные получает из окружения сервиса, а не из
# файла: секреты не должны лежать рядом с кодом.

# ─── Обязательные секреты ───────────────────────────────────────────────────
# Три разных ключа, и это не перестраховка: ротация одного из них не должна
# ломать остальные (R-SEC-26). Сгенерировать:
#   openssl rand -hex 32

SESSION_SECRET=      # подпись сессий и демо-отметки браузера
BLIND_INDEX_SECRET=  # HMAC для поиска аккаунта по адресу
ADDRESS_SECRET=      # шифротекст адреса (AES-256-GCM)

# ─── База данных ────────────────────────────────────────────────────────────

PGHOST=localhost
PGPORT=5432
PGUSER=имя_пользователя
PGDATABASE=serial_tracker
# DATABASE_URL=postgres://...        # полная строка вместо PG* — для приложения

# ─── Импорт каталога (F-12) ─────────────────────────────────────────────────

# Ключ TMDB: аккаунт на themoviedb.org → Settings → API → API Read Access
# Token. Без него сопоставление с TMDB невозможно: это единственный источник
# описаний, постеров, жанров и возрастных ограничений.
TMDB_TOKEN=

# Датасеты IMDb (title.basics.tsv.gz — 218 МБ, title.ratings.tsv.gz — 8 МБ)
# лежат в tools/data-spike/data/ и скачиваются скриптом импорта. В
# репозитории их нет: лицензия только на личное некоммерческое использование.
# IMDB_DATA_DIR=tools/data-spike/data

# ─── Почта (F-01-12) ────────────────────────────────────────────────────────
# Режим: smtp (по умолчанию) или devbox. Значение администратора в
# e_system_setting перекрывает переменную (DEC-035).

MAIL_MODE=smtp

# Провайдер отправки. Без SMTP_HOST письма остаются в очереди и повторяются —
# это не повод их терять.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sigmaseries.local

# Печатать письма в консоль, когда провайдер не настроен. Удобно на защите и
# в разработке; в бою оставьте пустым.
MAIL_PRINT=

# Секреты. Ключ TMDB и любые токены — только в переменных окружения (README спайка).
.env
.env.*
!.env.example

# Датасеты IMDb: ~230 МБ, лицензия только на личное некоммерческое использование.
# Скачивает `npm run import:candidates`, в репозитории не хранится.
data/imdb/
tools/data-spike/data/

# Собранные пакеты контекста — результат работы context-pack.mjs, генерируются на лету.
docs/_packs/

# Зависимости будущего приложения.
node_modules/

# Байт-код Python-инструментов (tools/figures, tools/idef0).
__pycache__/

.DS_Store
*.log

# Резервные копии базы: полгигабайта дампов, в репозитории не хранятся.
backups/

# Снимки QA-фикстур (`tools/qa-s77-login.mjs`): хеш пароля и секрет 2FA
# демо-администратора. Рядом с проектом, чтобы переживать перезапуск среды.
.qa/

# Скиллы агента, установленные в проект (agent-browser и прочие): к приложению
# отношения не имеют и тянутся при `agent-browser install`.
.agents/
skills-lock.json

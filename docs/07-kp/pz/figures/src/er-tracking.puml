@startuml
skinparam monochrome true
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam dpi 160
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 22
skinparam classAttributeIconSize 0
hide circle
hide empty methods

entity "e_user\nПользователь" as user {
  * id : bigint <<PK>>
  --
  * nickname : text
  * status : text
  * locale : text
  * timezone : text
}

entity "e_watch_status\nСтатус просмотра" as watch_status {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * status : text
  * source : text
}

entity "e_watch_mark\nОтметка серии" as watch_mark {
  # user_id : bigint <<FK, PK>>
  # episode_id : bigint <<FK, PK>>
  --
  * precision : text
  # batch_id : bigint <<FK, NULL>>
}

entity "e_progress\nПрогресс" as progress {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * marked : integer
  * aired : integer
  next_episode : integer
}

entity "e_subscription\nПодписка" as subscription {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * kind : text
  * source : text
  * enabled : boolean
}

entity "e_notification\nУведомление" as notification {
  * id : bigint <<PK>>
  --
  # user_id : bigint <<FK>>
  * kind : text
  * dedup_key : text
  read_at : timestamptz
}

user ||--o{ watch_status
user ||--o{ watch_mark
user ||--o{ progress
user ||--o{ subscription
user ||--o{ notification

@enduml

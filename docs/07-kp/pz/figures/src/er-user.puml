@startuml
skinparam monochrome true
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam dpi 160
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 30
skinparam classAttributeIconSize 0
hide circle
hide empty methods

entity "e_user\nПользователь" as user {
  * id : bigint <<PK>>
  --
  * nickname : text
  * status : text
  * locale : text
  * timezone : text
  * email_confirmed : boolean
  registered_at : timestamptz
}

entity "e_role_assignment\nНазначение роли" as role {
  * id : bigint <<PK>>
  --
  # user_id : bigint <<FK>>
  * role : text
  # granted_by : bigint <<FK>>
  expires_at : timestamptz
}

entity "e_watch_status\nСтатус просмотра" as watch_status {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * status : text
  * source : text
  * changed_at : timestamptz
}

entity "e_watch_mark\nОтметка серии" as watch_mark {
  # user_id : bigint <<FK, PK>>
  # episode_id : bigint <<FK, PK>>
  --
  * marked_at : timestamptz
  * precision : text
  # batch_id : bigint <<FK, NULL>>
}

entity "e_progress\nПрогресс" as progress {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * marked : integer
  * aired : integer
  last_season : integer
  last_episode : integer
  next_season : integer
  next_episode : integer
  * updated_at : timestamptz
}

entity "e_subscription\nПодписка" as subscription {
  # user_id : bigint <<FK, PK>>
  # series_id : bigint <<FK, PK>>
  --
  * kind : text
  * source : text
  * enabled : boolean
}

entity "e_notification\nУведомление" as notification {
  * id : bigint <<PK>>
  --
  # user_id : bigint <<FK>>
  * kind : text
  * category : text
  * params : jsonb
  * dedup_key : text
  read_at : timestamptz
}

entity "e_rating\nОценка" as rating {
  # user_id : bigint <<FK>>
  # series_id : bigint <<FK>>
  # episode_id : bigint <<FK, NULL>>
  --
  * object_type : text
  * value : smallint
  * counted : boolean
  * is_demo : boolean
  * updated_at : timestamptz
}

entity "e_material\nМатериал" as material {
  * id : bigint <<PK>>
  --
  # author_id : bigint <<FK>>
  # series_id : bigint <<FK, NULL>>
  * kind : text
  * state : text
  * version : integer
  * submitted_at : timestamptz
}

entity "e_editor_decision\nРешение редактора" as decision {
  * id : bigint <<PK>>
  --
  # material_id : bigint <<FK>>
  # editor_id : bigint <<FK>>
  # cluster_id : bigint <<FK, NULL>>
  * decision : text
  * reason : text
  matched_word : text
  * decided_at : timestamptz
}

entity "e_moderation_cluster\nКластер дублей" as cluster {
  * id : bigint <<PK>>
  --
  * signature : text <<UQ>>
  decision : text
  applied : boolean
}

entity "e_audit_log\nЖурнал аудита" as audit {
  * id : bigint <<PK>>
  --
  # actor_id : bigint <<FK, NULL>>
  * at : timestamptz
  * action : text
  * object_type : text
  object_id : bigint
  * result : text
}

user ||--o{ role
user ||--o{ watch_status
user ||--o{ watch_mark
user ||--o{ progress
user ||--o{ subscription
user ||--o{ notification
user ||--o{ rating
user ||--o{ material
material ||--o{ decision
user ||--o{ decision : "редактор"
cluster ||--o{ decision
user ||--o{ audit

@enduml

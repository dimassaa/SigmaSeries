{
  "name": "sigmaseries",
  "version": "0.1.0",
  "private": true,
  "description": "Track the series you watch, rate them, and never miss an episode. Release calendar, spoiler-aware reviews and discussions in one place.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --import ./tests/setup.js --test \"tests/**/*.test.js\"",
    "test:watch": "node --import ./tests/setup.js --test --watch \"tests/**/*.test.js\"",
    "test:only": "node --test",
    "db:extract": "python3 tools/schema/extract.py",
    "db:check": "python3 tools/schema/extract.py --check",
    "docs": "cd docs && python3 ../tools/docs-build/build_registries.py",
    "docs:check": "node tools/docs-build/context-pack.mjs --check",
    "verify": "npm run db:check && npm run css:check && npm run docs && npm run test && npm run docs:check",
    "css": "node tools/build-css.mjs",
    "css:check": "node tools/build-css.mjs --check",
    "start": "node --env-file-if-exists=.env src/server.js",
    "import:candidates": "node --env-file-if-exists=.env src/cli/import-candidates.js",
    "import:match": "node --env-file-if-exists=.env src/cli/import-match.js",
    "import:enrich": "node --env-file-if-exists=.env src/cli/import-enrich.js",
    "import:catalogue": "node --env-file-if-exists=.env src/cli/import-catalogue.js",
    "import:images": "node --env-file-if-exists=.env src/cli/import-images.js",
    "import:discover": "node --env-file-if-exists=.env src/cli/import-discover.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  }
}
